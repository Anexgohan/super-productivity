# Load environment variables
map "" $webdav_backend {
    default "$WEBDAV_BACKEND";
}

# Upgrade passthrough for the sync websocket. Without it the socket fails silently and clients degrade to polling rather than erroring.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen       ${APP_PORT};
    server_name  localhost;

    # Emit RELATIVE Location headers. nginx would otherwise rebuild redirects
    # as absolute URLs using its own listen port (80 inside the container),
    # dropping the published port — so a login redirect would send browsers to
    # http://host/login instead of http://host:18230/login. Relative headers let
    # the browser resolve against the URL it actually used, which is also what
    # keeps this correct behind a reverse proxy or a different published port.
    absolute_redirect off;

    # Docker's embedded DNS. Required because the bridge upstream is referenced
    # through a variable below, which defers resolution to request time — so
    # nginx still starts if sp-bridge is briefly unavailable, instead of
    # refusing to boot and taking the whole app down with it.
    resolver 127.0.0.11 valid=30s ipv6=off;

    # One origin, one port: app at /, sync server at /sync/, bridge at /api/.
    # Not auth_request-gated — both upstreams authenticate their own callers, and these were previously published on their own open ports anyway.
    location /sync/ {
        set $sync_upstream "${SP_SYNC_INTERNAL_URL}";
        # Explicit strip: proxy_pass does not rewrite the URI when its target contains a variable.
        rewrite ^/sync/(.*)$ /$1 break;
        proxy_pass $sync_upstream;

        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The websocket is long-lived; the default 60s would tear it down.
        proxy_read_timeout 3600s;
    }

    # ── Auth + REST API (anex/container-parity) ─────────────────────────────
    # The login page and session endpoints live in sp-bridge but are proxied
    # under THIS origin on purpose: the session cookie, the login page, and the
    # app then all share one origin, so there is no cross-origin redirect and
    # ?next= stays a plain same-origin path.
    location /api/ {
        set $bridge_api "${SP_BRIDGE_INTERNAL_URL}";
        proxy_pass $bridge_api$request_uri;
        proxy_set_header Host              $host;
        # Real client IP, so the bridge's login rate limiting keys on the
        # browser rather than on nginx's container address.
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /login {
        set $bridge_login "${SP_BRIDGE_INTERNAL_URL}";
        proxy_pass $bridge_login$request_uri;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Session check for each gated request. `internal` keeps it unreachable
    # from outside; nginx forwards the original Cookie header automatically.
    location = /_auth {
        internal;
        set $bridge_verify "${SP_BRIDGE_INTERNAL_URL}";
        proxy_pass $bridge_verify/api/auth/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host            $host;
        proxy_set_header X-Original-URI  $request_uri;
    }

    # Relative Location (see absolute_redirect above) keeps ?next= a plain
    # same-origin path, so the post-login hop cannot be pointed off-site.
    location @login_redirect {
        return 302 /login?next=$request_uri;
    }

    # serve super-productivity as static files at the path /
    location / {
        # Either "/_auth" or "off" — see docker-entrypoint.sh (SP_AUTH_ENABLED).
        # This gate is what makes the embedded sync token unreachable to anyone
        # without a session; before it existed, reaching this port was enough.
        auth_request ${SP_AUTH_REQUEST};
        error_page 401 403 = @login_redirect;

        root   /usr/share/nginx/html;
        index  index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # forward requests starting with "/webdav/" to $WEBDAV_BACKEND
    # note: the prefix "/webdav" is removed during forwarding
    location = /webdav {
        return 302 /webdav/;
    }
    location /webdav/ {
        if ($webdav_backend = "") {
            return 404;
        }

        rewrite ^/webdav/(.*)$ /$1 break;   # remove the `/webdav/` prefix
        proxy_pass $webdav_backend;
    }

    # redirect server error pages to the static page /50x.html
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}
