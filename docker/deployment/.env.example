# Super Productivity stack — copy to .env and edit.
#   docker compose up -d --build
# One published port serves everything: app at /, sync at /sync/, API at /api/.

### --- REQUIRED (change these) --- ###

JWT_SECRET=CHANGE_ME # openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME # openssl rand -hex 16
SP_SYNC_ENCRYPTION_PASSWORD=CHANGE_ME # losing this loses the data — back it up

# Sync server account, not the browser login. Created on first start, no email is sent. The password must be at least 8 characters or provisioning stops and no sync token is served.
SP_SYNC_ACCOUNT_EMAIL=you@example.com
SP_SYNC_ACCOUNT_PASSWORD=CHANGE_ME

### --- OPTIONAL (keep defaults) --- ###

SP_WEB_PORT=18230 # the only published port
SP_IMAGE_TAG=latest # or pin a release, e.g. 0.2.0
ALLOW_INSECURE_HTTP=true # false when behind a TLS proxy

# Blank means the bridge mints one on first boot and prints it once to its log.
SP_BRIDGE_API_KEY=

POSTGRES_USER=supersync
POSTGRES_DB=supersync
POSTGRES_HOST=postgres # external db? point these at your server
POSTGRES_PORT=5432

STACK_PREFIX=sp
SUPERSYNC_MEM_LIMIT=512m
SP_BRIDGE_MEM_LIMIT=256m
POSTGRES_MEM_LIMIT=256m
PG_SHARED_BUFFERS=64MB
SP_BRIDGE_POLL_INTERVAL_SEC=15 # websocket is primary; this is the fallback
