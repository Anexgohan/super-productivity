# ─────────────────────────────────────────────────────────────────────────────
# Super Productivity stack — configuration
#
#   cp .env.example .env   → set your host and generate the three secrets
#   docker compose up -d
#
# Only settings that need a human decision live here. Everything else has a
# sensible default in compose.yml; see "Advanced" at the bottom to override.
# ─────────────────────────────────────────────────────────────────────────────

# ── Where this deployment is reachable ───────────────────────────────────────
# The address BROWSERS use — not "localhost" unless you only ever use this
# machine. The sync and CORS URLs are derived from it automatically.
SP_PUBLIC_HOST=192.168.1.10

SP_WEB_PORT=18230
SUPERSYNC_PORT=18231
SP_BRIDGE_PORT=18232

# ── Secrets — generate each one, never reuse ─────────────────────────────────
# openssl rand -hex 32
JWT_SECRET=CHANGE_ME
# openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME
# openssl rand -hex 24  — required by the REST API (except /api/health, /api/docs)
SP_BRIDGE_API_KEY=CHANGE_ME

# ── Your sync account ────────────────────────────────────────────────────────
# Created automatically on first start; no email verification round-trip.
SP_SYNC_ACCOUNT_EMAIL=you@example.com
# Min 8 characters.
SP_SYNC_ACCOUNT_PASSWORD=CHANGE_ME
# End-to-end encryption passphrase for your data. Losing this loses the data —
# back it up somewhere safe.
SP_SYNC_ENCRYPTION_PASSWORD=CHANGE_ME

# ── Transport security ───────────────────────────────────────────────────────
# true  = plain HTTP on a trusted LAN (disables browser HTTPS-upgrade + HSTS)
# false = behind a TLS reverse proxy; also set NODE_ENV=production below
ALLOW_INSECURE_HTTP=true

# ─────────────────────────────────────────────────────────────────────────────
# Advanced — uncomment only if you need it. Defaults live in compose.yml.
# ─────────────────────────────────────────────────────────────────────────────
# Behind a TLS proxy or custom domain, set the public URLs explicitly instead
# of deriving them from SP_PUBLIC_HOST:
#SP_PUBLIC_SYNC_URL=https://sync.example.com
#CORS_ORIGINS=https://tasks.example.com
#NODE_ENV=production
#
# Anyone who can reach the web port gets a logged-in session. Set false to make
# browsers enter the sync token manually.
#SP_SYNC_EMBED_TOKEN_IN_WEBAPP=true
#
# Container name prefix, resource caps, postgres tuning, bridge poll fallback
# (the bridge uses live websocket push; the poll is only a safety net):
#STACK_PREFIX=sp
#SUPERSYNC_MEM_LIMIT=512m
#SP_BRIDGE_MEM_LIMIT=256m
#POSTGRES_MEM_LIMIT=256m
#PG_SHARED_BUFFERS=64MB
#SP_BRIDGE_POLL_INTERVAL_SEC=15
