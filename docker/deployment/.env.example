# Copy to .env and edit. Everything under REQUIRED must be changed.

### --- REQUIRED (change these) --- ###

JWT_SECRET='CHANGE_ME'                   # openssl rand -hex 32
POSTGRES_PASSWORD='CHANGE_ME'            # openssl rand -hex 16
SP_SYNC_ENCRYPTION_PASSWORD='CHANGE_ME'  # losing this loses the data — back it up
SP_SYNC_ACCOUNT_EMAIL='you@example.com'  # sync server account, not your browser login
SP_SYNC_ACCOUNT_PASSWORD='CHANGE_ME'     # min 8 characters

### --- OPTIONAL (keep defaults) --- ###

TZ='UTC'                    # set yours: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
SP_WEB_PORT='18230'         # the only published port
SP_IMAGE_TAG='latest'       # or pin a release, e.g. 0.2.1
ALLOW_INSECURE_HTTP='true'  # false when behind a TLS proxy
POSTGRES_USER='sp_user'     # database role, created on first start
POSTGRES_DB='db_sp'         # database name, created on first start
POSTGRES_HOST='sp_postgres'  # external db? point these at your server
POSTGRES_PORT='5432'        # change only for an external db on a custom port
STACK_PREFIX='sp'           # container name prefix: sp-web, sp-bridge, ...
SUPERSYNC_MEM_LIMIT='512m'  # sync server cap
SP_BRIDGE_MEM_LIMIT='256m'  # bridge cap; grows with task count
POSTGRES_MEM_LIMIT='256m'   # database cap
PG_SHARED_BUFFERS='64MB'    # postgres cache; keep well under POSTGRES_MEM_LIMIT
PG_MAX_CONNECTIONS='20'     # ample for this stacks three clients
SP_BRIDGE_POLL_INTERVAL_SEC='15'  # websocket is primary; this is the fallback
