# ─────────────────────────────────────────────────────────────────────────────
# Anex SP stack configuration — copy to .env and edit.
# Every value here is user-controlled; nothing is hardcoded in compose.yml.
# ─────────────────────────────────────────────────────────────────────────────

# Container name prefix
STACK_PREFIX=sp

# ── Ports (host side) ────────────────────────────────────────────────────────
SP_WEB_PORT=18230
SUPERSYNC_PORT=18231

# ── Public URLs (what BROWSERS/clients use to reach the sync server) ─────────
# Set to the host's LAN address when accessing from other machines, e.g.:
#   SP_PUBLIC_SYNC_URL=http://192.168.100.x:18231
#   CORS_ORIGINS=http://192.168.100.x:18230
SP_PUBLIC_SYNC_URL=http://localhost:18231
CORS_ORIGINS=http://localhost:18230

# ── SuperSync server ─────────────────────────────────────────────────────────
# development is required for plain-HTTP PUBLIC_URL (upstream enforces HTTPS
# under production). See compose.yml note.
NODE_ENV=development
RUN_MIGRATIONS_ON_STARTUP=true
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
SUPERSYNC_MEM_LIMIT=512m

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_USER=supersync
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=supersync
PG_SHARED_BUFFERS=64MB
PG_MAX_CONNECTIONS=20
POSTGRES_MEM_LIMIT=256m

# Plain-HTTP LAN mode: disables browser https-upgrade/HSTS (our patch).
# Set false when behind a TLS reverse proxy.
ALLOW_INSECURE_HTTP=true
